# Create a MongoDB Atlas database user and paste its connection string below.
# URL-encode special characters in the database user's password.
MONGODB_URI=mongodb+srv://<db_username>:<encoded_password>@<cluster-host>/keru?retryWrites=true&w=majority

# Replace these before deployment; do not use the development defaults in production.
ADMIN_USER=your-admin-username
ADMIN_PASS=use-a-long-unique-password

# Create a Neon Postgres project and paste its pooled connection string below.
# Use the URI copied from Neon; keep its sslmode=require option.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Firebase Authentication project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase service-account JSON. Keep this secret and never expose it to frontend code.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Create this account in Firebase Authentication first, then include its verified email here.
FIREBASE_ADMIN_EMAILS=admin@example.com

# Create a Neon Postgres project and paste its pooled connection string below.
# Use the URI copied from Neon; keep its sslmode=require option.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Replace these before deployment; do not use the development defaults in production.
ADMIN_USER=your-admin-username
ADMIN_PASS=use-a-long-unique-password
